serve "=== QUEUE TEST ===";

brew q = Queue();
q.enqueue(1);
q.enqueue(2);
q.enqueue(3);

serve q.dequeue();
serve q.dequeue();
q.enqueue(4);
q.enqueue(5);
serve q.dequeue();
serve q.dequeue();
serve q.dequeue();
serve q.size;


