craft thrice(fn) {
  fn(1);
  fn(2);
  fn(3);
}

thrice(craft(a) {
  serve a;
});


brew add = craft(a, b) {
  offer a + b;
};

serve add(3, 4);



// break test
brew i = 0;
while (true) {
    if (i == 5) break;
    serve i;
    i = i + 1;
}
// should serve 0 1 2 3 4

// continue test
brew j = 0;
while (j < 10) {
    j = j + 1;
    if (j == 3) continue;
    if (j == 7) continue;
    serve j;
}
// should serve 1 2 4 5 6 8 9 10

// break in for loop
for (brew k = 0; k < 100; k = k + 1) {
    if (k == 3) break;
    serve k;
}
// should serve 0 1 2

// nested loops - break only exits inner
for (brew x = 0; x < 3; x = x + 1) {
    for (brew y = 0; y < 3; y = y + 1) {
        if (y == 1) break;
        serve x;
    }
}
// should serve 0 1 2 (once per outer iteration)
